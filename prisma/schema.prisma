generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

// ========== ПОЛЬЗОВАТЕЛЬ ==========
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(USER)
  verified  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provider  String?
  providerId String?

  favorites         Favorite[]
  VerificationCode  VerificationCode?
}

// ========== КАТЕГОРИИ ==========
model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  exercises   Exercise[]
  programs    Program[]
  meals       Meal[]
  coachings   Coaching[]
  supplements Supplement[]
}

// ========== УПРАЖНЕНИЯ ==========
model Exercise {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  videoUrl     String?
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  muscleGroups MuscleGroup[] // implicit many-to-many!

  favorites         Favorite[]
  programExercises  ProgramExercise[]
  createdAt         DateTime @default(now())
}


// ========== ПРОГРАММЫ ==========
model Program {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  level       String   // "easy", "medium", "hard"
  weeks       Int?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  exercises   ProgramExercise[]
  createdAt   DateTime @default(now())
}

// ========== СВЯЗЬ ПРОГРАММА → УПРАЖНЕНИЯ ==========
model ProgramExercise {
  id         Int @id @default(autoincrement())
  programId  Int
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  sets       Int?
  reps       Int?
  order      Int
  @@unique([programId, exerciseId])
}

// ========== ПИТАНИЕ ==========
model Meal {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  calories    Int?
  mealType    String   // "breakfast", "lunch", "dinner", "snack"
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  createdAt   DateTime @default(now())
}

// ========== ОНЛАЙН-ВЕДЕНИЕ ==========
model Coaching {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int?
  duration    String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  createdAt   DateTime @default(now())
}

// ========== СПОРТИВНОЕ ПИТАНИЕ ==========
model Supplement {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  price       Int?
  weight      String?
  flavor      String?
  brand       String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  favorites   Favorite[]
}

// ========== ИЗБРАННОЕ ==========
model Favorite {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId   Int?
  exercise     Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  programId    Int?
  program      Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)

  mealId       Int?
  meal         Meal?        @relation(fields: [mealId], references: [id], onDelete: Cascade)

  coachingId   Int?
  coaching     Coaching?    @relation(fields: [coachingId], references: [id], onDelete: Cascade)

  supplementId Int?
  supplement   Supplement?  @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())

  // Уникальность, чтобы нельзя было добавить одну и ту же сущность дважды
  @@unique([userId, exerciseId])
  @@unique([userId, programId])
  @@unique([userId, mealId])
  @@unique([userId, coachingId])
  @@unique([userId, supplementId])
}


model MuscleGroup {
  id        Int      @id @default(autoincrement())
  name      String   // "Грудные", "Бицепс"
  slug      String   @unique // "chest", "biceps" 
  createdAt DateTime @default(now())

  exercises Exercise[] 
}

// ========== КОД ВЕРИФИКАЦИИ ==========
model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  code      String
  createdAt DateTime @default(now())

  @@unique([userId, code])
}